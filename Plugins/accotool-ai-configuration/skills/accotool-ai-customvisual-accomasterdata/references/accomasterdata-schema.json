      }
    },
    "JsonSchemas": {
      "datagrid.initialState": {
        "Type": "string (JSON)",
        "DefaultValue": "{}",
        "Schema": {
          "Type": "object",
          "Description": "MUI DataGrid initial state (GridInitialStatePremium).",
          "AdditionalProperties": true
        }
      },
      "datagrid.themeJSON": {
        "Type": "string (JSON)",
        "DefaultValue": "{\n  \"palette\": {\n    \"primary\": { \"main\": \"#383838\" },\n    \"secondary\": { \"main\": \"#ececec\" }\n  },\n  \"shape\": { \"borderRadius\": \"0px\" }\n}",
        "Schema": {
          "Type": "object",
          "Properties": {
            "palette": {
              "Type": "object",
              "AdditionalProperties": true
            },
            "shape": {
              "Type": "object",
              "Properties": {
                "borderRadius": {
                  "Type": "string|number"
                }
              },
              "AdditionalProperties": true
            }
          },
          "AdditionalProperties": true
        }
      },
      "datagrid.themeJSONLastSave": {
        "Type": "string (JSON)",
        "DefaultValue": null,
        "Schema": {
          "Type": "object",
          "Description": "Last persisted theme snapshot.",
          "AdditionalProperties": true
        }
      },
      "datagrid.rowHeightIndividual": {
        "Type": "string (JSON)",
        "DefaultValue": "{}",
        "Schema": {
          "Type": "object",
          "Properties": {
            "<rowId>": {
              "Type": "number"
            }
          },
          "AdditionalProperties": {
            "Type": "number"
          }
        }
      },
      "validation.conditionalFormatting": {
        "Type": "string (JSON)",
        "DefaultValue": "[]",
        "Schema": {
          "Type": "array",
          "Items": {
            "Type": "object",
            "Properties": {
              "ruleActive": { "Type": "boolean" },
              "title": { "Type": "string" },
              "columns": { "Type": "array", "Items": { "Type": "string" } },
              "condition": { "Type": "string" },
              "format": {
                "Type": "object",
                "Properties": {
                  "reactCSS": {
                    "Type": "object",
                    "Properties": {
                      "backgroundColor": { "Type": "string" },
                      "fontColor": { "Type": "string" },
                      "fontStyle": { "Type": "string" },
                      "fontWeight": { "Type": "string" },
                      "textDecoration": { "Type": "string" }
                    },
                    "AdditionalProperties": true
                  },
                  "adornments": {
                    "Type": "object",
                    "Properties": {
                      "prepend": { "Type": "string" },
                      "append": { "Type": "string" }
                    },
                    "AdditionalProperties": true
                  },
                  "lock": { "Type": "boolean" },
                  "save": { "Type": "boolean" }
                },
                "AdditionalProperties": true
              }
            },
            "AdditionalProperties": true
          }
        }
      },
      "validation.groupingSettings": {
        "Type": "string (JSON)",
        "DefaultValue": "[]",
        "Schema": {
          "Type": "array",
          "Items": {
            "Type": "object",
            "Properties": {
              "title": { "Type": "string" },
              "columns": { "Type": "array", "Items": { "Type": "string" } },
              "expanded": { "Type": "boolean" }
            },
            "AdditionalProperties": true
          }
        }
      },
      "validation.calculationSettings": {
        "Type": "string (JSON)",
        "DefaultValue": "[]",
        "Schema": {
          "Type": "array",
          "Items": {
            "Type": "object",
            "Properties": {
              "title": { "Type": "string" },
              "column": { "Type": "string" },
              "formula": { "Type": "string" }
            },
            "AdditionalProperties": true
          }
        }
      },
      "customColumns.customColumnDefinitions": {
        "Type": "string (JSON)",
        "DefaultValue": "[]",
        "Schema": {
          "Type": "array",
          "Description": "Calculated/custom column definitions.",
          "Items": {
            "Type": "object",
            "AdditionalProperties": true
          }
        }
      },
      "measures.gradientColors": {
        "Type": "string (JSON)",
        "DefaultValue": null,
        "Schema": {
          "Type": "object",
          "Properties": {
            "first": { "Type": "string", "Format": "color" },
            "second": { "Type": "string", "Format": "color" },
            "third": { "Type": "string", "Format": "color" }
          },
          "Required": ["first", "second", "third"],
          "AdditionalProperties": false
        }
      }
    }
  },
  "CustomVisualSettings": {
    "ColumnGroupsState": {
      "InternalPropertyName": "columnGroupsState:<reportId>",
      "Schema": {
        "Type": "object",
        "Properties": {
          "<groupId>": {
            "Type": "boolean"
          }
        },
        "AdditionalProperties": {
          "Type": "boolean"
        }
      }
    },
    "ColumnWidths": {
      "InternalPropertyName": "columnWidths:<reportId>",
      "Schema": {
        "Type": "object",
        "Properties": {
          "<columnField>": {
            "Type": "number"
          }
        },
        "AdditionalProperties": {
          "Type": "number"
        }
      }
    },
    "RowHeightIndividualStorage": {
      "InternalPropertyName": "rowHeightIndividual:<reportId>",
      "Schema": {
        "Type": "object",
        "Properties": {
          "<rowId>": {
            "Type": "number"
          }
        },
        "AdditionalProperties": {
          "Type": "number"
        }
      }
    },
    "RecentColors": {
      "InternalPropertyName": "recentColors:<reportId>",
      "Schema": {
        "Type": "array",
        "Items": {
          "Type": "string",
          "Format": "color"
        }
      }
    },
    "ReadNotifications": {
      "InternalPropertyName": "accoPLANNING_ReadNotifications",
      "Schema": {
        "Type": "array",
        "Items": {
          "Type": "object",
          "Properties": {
            "key": { "Type": "string" },
            "title": { "Type": "string" },
            "content": { "Type": "string" },
            "severity": {
              "Type": "string",
              "Enum": ["blue", "green", "yellow", "red"]
            }
          },
          "Required": ["key", "title", "content", "severity"],
          "AdditionalProperties": false
        }
      }
    }
  }
}
